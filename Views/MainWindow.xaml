<Window x:Class="TopuClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopuClient - Modern Launcher" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#121214" CornerRadius="12" BorderBrush="#2D2D30" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <StackPanel Grid.Column="0" Background="#18181B" Margin="0,0,0,0">
                <TextBlock Text="TOPU CLIENT" Foreground="#00FF66" FontWeight="Bold" FontSize="18" Margin="20,25,20,20" HorizontalAlignment="Center"/>
                
                <Button Content="Play" x:Name="NavPlayBtn" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" Background="#27272A" Height="40" Margin="10,5"/>
                <Button Content="Mods (Modrinth)" x:Name="NavModsBtn" Foreground="#A1A1AA" Background="Transparent" Height="40" Margin="10,5"/>
                <Button Content="Profiles" x:Name="NavProfilesBtn" Foreground="#A1A1AA" Background="Transparent" Height="40" Margin="10,5"/>
                <Button Content="Settings" x:Name="NavSettingsBtn" Foreground="#A1A1AA" Background="Transparent" Height="40" Margin="10,5"/>
            </StackPanel>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Bar: Account info & Window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0">
                    <TextBlock x:Name="TxtUsername" Text="Not Logged In" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Microsoft Login" x:Name="BtnMsLogin" Click="BtnMsLogin_Click" Background="#00A4EF" Foreground="White" Padding="10,5"/>
                </StackPanel>

                <!-- Central Dashboard / Play Section -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="THE NEON GUARD" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ComboBox x:Name="CbProfiles" Width="300" Height="35" Margin="0,0,0,15"/>
                    <Button Content="LAUNCH GAME" x:Name="BtnLaunch" Click="BtnLaunch_Click" Width="300" Height="50" Background="#00FF66" Foreground="Black" FontWeight="Bold" FontSize="16"/>
                    <ProgressBar x:Name="PbDownload" Width="300" Height="8" Margin="0,15,0,0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
